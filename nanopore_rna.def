Bootstrap: library
From: debian:11

%post
    apt update && apt install -y libbz2-dev libcurl4-openssl-dev liblzma-dev python3 python3-dev python3-pip snakemake wget
    cd /opt
    wget https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh
    mkdir /root/.conda
    bash Miniforge3-Linux-x86_64.sh -b -p /opt/miniforge3
    rm Miniforge3-Linux-x86_64.sh
    wget https://github.com/ConesaLab/SQANTI3/archive/refs/tags/v5.2.2.tar.gz
    tar -xf v5.2.2.tar.gz
    rm v5.2.2.tar.gz

%environment
    PATH=$PATH:/opt/miniforge3/bin

%files
    ./workflow /opt/nanopore_rna/
    ./LICENSE.md /opt/nanopore_rna/
    ./README.md /opt/nanopore_rna/

%runscript
    VERSION='0.0.1+20241205'

    echo ''
    echo 'nanopore_rna: RNA-Seq nanopore pipeline'
    echo 'Copyright (C) 2024, Pedro Garrido Rodríguez'
    echo ''
    echo 'This program is distributed in the hope that it will be useful,'
    echo 'but WITHOUT ANY WARRANTY; without even the implied warranty of'
    echo 'MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.'
    echo ''
    echo "Version $VERSION"
    echo ''

    if [ "$#" -eq 0 ]; then
        echo "No arguments supplied."
        echo "Use 'singularity run-help nanopore_rna.sif' to get help."
        exit 2
    fi

    while [ $# -gt 0 ]; do
        case $1 in 
            -i|--input)
                INPUT="$2"
                shift
                shift
                ;;
            -o|--output)
                OUTDIR="$2"
                shift
                shift
                ;;
            -r|--reference)
                REF="$2"
                shift
                shift
                ;;
            -g|--gtf)
                REF_TX="$2"
                shift
                shift
                ;;
            -d|--diffmod)
                DIFFMOD="$2"
                shift
                shift
                ;;
            -n|--dryrun)
                DRYRUN=1
                shift
                ;;
            -t|--threads)
                THREADS="$2"
                shift
                shift
                ;;
            -v|--version)
                exit
                shift
                ;;
            -*|--*)
                echo "Unknown option $1"
                exit 1
                ;;
            *)
                echo "Unknown argument $1"
                exit 1
                ;;
        esac
    done

    if [ -z $INPUT ] || [ -z $OUTDIR ] || [ -z $REF ] || [ -z $REF_TX ] || [ -z $DIFFMOD ]; then
        echo "Arguments -i, -o , -r, -g and -d are required."
        echo "Use 'singularity run-help nanopore_rna.sif' to get help."
        exit 2
    fi

    if [ $DRYRUN ]; then
        snakemake -s /opt/nanopore_rna/workflow/Snakefile -n \
            -kj $THREADS \
            --configfile /opt/nanopore_rna/workflow/config/config.yml \
            --config \
            input_dir=$INPUT \
            out_dir=$OUTDIR \
            ref=$REF \
            ref_tx=$REF_TX \
            xpore_diffmod=$DIFFMOD \
            --singularity-args "-B $INPUT,$OUTDIR,$REF,$REF_TX,$DIFFMOD"
    else
        snakemake -s /opt/nanopore_rna/workflow/Snakefile \
            -kj $THREADS \
            --configfile /opt/nanopore_rna/workflow/config/config.yml \
            --config \
            input_dir=$INPUT \
            out_dir=$OUTDIR \
            ref=$REF \
            ref_tx=$REF_TX \
            xpore_diffmod=$DIFFMOD \
            --singularity-args "-B $INPUT,$OUTDIR,$REF,$REF_TX,$DIFFMOD"
    fi

%labels
    Author: Pedro Garrido Rodríguez
    Contact: pedro (dot) garridor (at) outlook (dot) es
    Version: 0.0.1+20241205

%help

    nanopore_rna: RNA-Seq nanopore pipeline

    This program is distributed in the hope that it will be useful,
    but WITHOUT ANY WARRANTY; without even the implied warranty of
    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.

    Version 0.0.1+20241205


    Usage: singularity run nanopore_rna.sif [arguments]

    Required:
        -i, --input PATH                        raw data folder
        -o, --output PATH                       output folder
        -r, --ref reference PATH                reference genome folder
        -t, --gtf                               reference transcriptome GTF
    
    Optional arguments:
        -t [1]                                  threads
        -n                                      perform a dry run
    
